# Kept — monetizable beta env
# Copy to .env.local and fill in Stripe values for real checkout.

# Public site URL used in Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 once Stripe is configured (optional UI hint)
NEXT_PUBLIC_STRIPE_ENABLED=0

# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# Stripe Price ID for Kept Pro monthly subscription (price_...)
STRIPE_PRICE_ID=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
